# Auth.js / NextAuth
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Only this GitHub username can manage the blog
ADMIN_GITHUB_USERNAME=167581103

# Production site URL — must include https:// (not just chenguo.dev)
# Prefer your canonical host, e.g. https://www.chenguo.dev
AUTH_URL=https://www.example.com

# Vercel Blob (articles + media)
# Preferred on Vercel: connect a Blob store (OIDC). You may see:
#   BLOB_STORE_ID  or  blog_STORE_ID  (+ auto VERCEL_OIDC_TOKEN)
# Optional static token (local/CI outside Vercel):
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# blog_STORE_ID=

# Giscus (GitHub Discussions comments) — all optional; code has defaults.
# Override only if you change repo/category.
NEXT_PUBLIC_GISCUS_REPO=167581103/blog
NEXT_PUBLIC_GISCUS_REPO_ID=R_kgDOTgQRdw
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOTgQRd84DCABW
