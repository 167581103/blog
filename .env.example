# Auth.js / NextAuth
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# This GitHub username can write/edit; any GitHub user may sign in to comment
ADMIN_GITHUB_USERNAME=167581103

# Production site URL — must include https:// (not just chenguo.dev)
# Prefer your canonical host, e.g. https://www.chenguo.dev
# Set AUTH_URL for Production only. Leave unset on Preview so trustHost
# uses the deployment host (see docs/staging.md).
AUTH_URL=https://www.example.com

# Preview / Staging (optional): OAuth via production callback proxy so
# ephemeral *.vercel.app URLs can sign in without registering each one.
# Requires the same AUTH_SECRET + GitHub OAuth App as Production.
# AUTH_REDIRECT_PROXY_URL=https://www.example.com/api/auth

# Staging fixed domain (if using a second GitHub OAuth App instead of proxy):
# AUTH_URL=https://staging.example.com

# AWS S3 — static media (editor uploads + resume PDF)
# Prefer an Access Point ARN (region must match the Access Point):
S3_ACCESS_POINT_ARN=arn:aws:s3:ap-southeast-2:ACCOUNT_ID:accesspoint/blog
# Or a plain bucket name:
# S3_BUCKET=my-blog-bucket
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CloudFront / public CDN base (no trailing slash).
# When unset, the app serves files via /api/media/... so the Access Point
# can stay private.
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Vercel Blob (legacy — optional fallback for media if S3 is unset;
# also used once for importing old article JSON after a quota block lifts)
# Preferred on Vercel: connect a Blob store (OIDC). You may see:
#   BLOB_STORE_ID  or  blog_STORE_ID  (+ auto VERCEL_OIDC_TOKEN)
# Optional static token (local/CI outside Vercel):
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# blog_STORE_ID=
# Optional: force public CDN reads (Simple ops) when token/store id is odd.
# Host id is the part before `.public.blob.vercel-storage.com`.
# BLOB_PUBLIC_HOST_ID=
# Or full base, e.g. https://xxxx.public.blob.vercel-storage.com
# BLOB_PUBLIC_BASE_URL=

# Neon Postgres (comments, users, future tags/annotations)
# Prefer: Vercel Marketplace → Neon → connect to this project
# Then pull: vercel env pull .env.local
DATABASE_URL=
# Sometimes also provided:
# POSTGRES_URL=
# DATABASE_URL_UNPOOLED=
